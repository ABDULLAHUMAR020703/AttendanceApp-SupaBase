# Mobile app (Expo) — NOT used by Coolify docker compose.
# Copy to .env and restart Expo after changes.
# EXPO_PUBLIC_ prefix is required for Expo to expose these to the app.

########################
# Supabase (anon / public)
########################
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Never put SUPABASE_SERVICE_ROLE_KEY here.
# API gateway URL for device builds is configured in app.json → expo.extra.apiGatewayUrl
# (production: https://api.hadir.techdotglobal.com).
