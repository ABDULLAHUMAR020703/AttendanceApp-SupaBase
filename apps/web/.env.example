# Web admin portal (Vercel / Vite) — NOT used by Coolify docker compose.
# Set these in Vercel → Project → Settings → Environment Variables.

########################
# Application (API gateway)
########################
# Prefer VITE_API_GATEWAY_URL. NEXT_PUBLIC_API_URL is an alternate (same value).
VITE_API_GATEWAY_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

########################
# Supabase (anon / public)
########################
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
