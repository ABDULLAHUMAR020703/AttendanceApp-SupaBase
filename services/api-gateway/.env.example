# API Gateway Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
# Local default: 3000. Coolify/docker-compose production: 80 (Traefik → https://domain).
PORT=3000

# Host to bind to (0.0.0.0 allows connections from all interfaces, including devices)
# Use 0.0.0.0 for device access, localhost for local-only access
HOST=0.0.0.0

# Auth Service Configuration
# URL of the Auth Service (default: http://localhost:3001)
# Docker Compose / Coolify: http://auth-service:3001
AUTH_SERVICE_URL=http://localhost:3001

# Reporting Service Configuration
# URL of the Reporting Service (default: http://localhost:3002)
# Docker Compose / Coolify: http://reporting-service:3002
REPORTING_SERVICE_URL=http://localhost:3002
