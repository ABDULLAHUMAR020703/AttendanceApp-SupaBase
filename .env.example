# =============================================================================
# Canonical environment file — Coolify / docker compose (backend stack)
# =============================================================================
# Copy to `.env` for local `docker compose`, or paste into Coolify → Environment.
# Never commit real secrets.
#
# Frontend (Vercel / Expo) uses separate files:
#   apps/web/.env.example
#   apps/mobile/.env.example
#
# Local `npm start` per service still uses:
#   services/<name>/.env  (see each service’s .env.example)
#
# Compose already sets NODE_ENV, HOST, PORT, AUTH_SERVICE_URL, and
# REPORTING_SERVICE_URL inside containers. Do not override those in Coolify.

########################
# Application
########################
# (Production values for NODE_ENV / HOST / PORT are set in docker-compose.yml.
#  Nothing required here for Coolify.)

########################
# Supabase
########################
# Required by auth-service + reporting-service (service role bypasses RLS).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

########################
# JWT / Authentication
########################
# JWTs are issued and verified by Supabase Auth. There is no app-level JWT_SECRET.
# Clients use the anon key (see apps/*/ .env.example). Backends use the service role above.

########################
# SMTP
########################
# Used by reporting-service (Nodemailer). Required for email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-account@gmail.com
SMTP_PASS=your-gmail-app-password

########################
# Reporting
########################
# Optional From address (defaults to SMTP_USER).
EMAIL_FROM=
# Do NOT set REPORT_RECIPIENT_EMAIL or SUPER_ADMIN_EMAIL — they are unused and
# would break multi-tenant recipient routing (recipients come from the DB).

########################
# Company Onboarding
########################
# Required after the first company exists (sent as X-Onboarding-Key).
# Generate a long random string (min 16 characters).
COMPANY_ONBOARDING_SECRET=

########################
# Logging
########################
# Optional build identity shown on /health (Coolify/CI may inject this).
GIT_COMMIT_SHA=

########################
# Optional Development
########################
# Local Docker only (docker-compose.override.yml). Not used by Coolify Traefik.
GATEWAY_PUBLISH_PORT=3000
