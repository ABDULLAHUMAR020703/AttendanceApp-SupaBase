# Production environment for docker-compose / Coolify
# Paste these into Coolify → Environment Variables (or copy to a local .env).
# Never commit real secrets.

# ─── Required (auth-service + reporting-service) ───
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Auth Service ───
# Required after the first company exists (sent as X-Onboarding-Key)
COMPANY_ONBOARDING_SECRET=

# ─── Reporting Service (SMTP) — required for email delivery ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-account@gmail.com
SMTP_PASS=your-gmail-app-password
# Optional From address (defaults to SMTP_USER)
EMAIL_FROM=

# ─── Optional ───
GIT_COMMIT_SHA=

# Local override only (docker-compose.override.yml). Not used by Coolify Traefik.
GATEWAY_PUBLISH_PORT=3000

# DO NOT set REPORT_RECIPIENT_EMAIL or SUPER_ADMIN_EMAIL — breaks multi-tenant email routing.
# DO NOT override PORT / AUTH_SERVICE_URL / REPORTING_SERVICE_URL in Coolify.

# ─── Coolify notes ───
# - Assign domain ONLY to api-gateway as: https://api.yourdomain.com
# - No port in the public URL. Gateway listens on container port 80; Traefik serves 443.
# - Keep auth-service and reporting-service private (no public domain, no Ports Mappings)
# - End users and Vercel/mobile clients call https://api.yourdomain.com (never :3000)
